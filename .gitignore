# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/docs/
.application-photos/

# Local runtime, QA and scratch outputs
artifacts/
*.ipynb
.ipynb_checkpoints/
*.apk
*.aab
*.ipa

# Local databases and backups are never source-controlled
*.mdf
*.ldf
*.bak
*.sqlite
*.sqlite3

# Real environment values and signing material stay in a secret store
.env
.env.*
!.env.example
!**/.env.example
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt
*.der
*.mobileprovision
*.keystore
*.jks

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
