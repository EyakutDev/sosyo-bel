# Bu dosya yalnız değişken adlarını gösterir; gerçek değerler commit edilmez.
ConnectionStrings__SosyoBel=Server=SQL_PRIVATE_HOST,1433;Database=SosyalHizmetDb;User Id=sosyobel_api;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False

# En az 32 rastgele byte Base64 olarak saklanır; kaynak koda yazılmaz.
Authentication__Jwt__SigningKeyBase64=CHANGE_WITH_BASE64_ENCODED_RANDOM_BYTES

# KPS kimlik ve adres POST uçlarının ortak taban adresidir; kod içine sabitlenmez.
Kps__BaseUrl=http://KPS_PRIVATE_HOST:8090
Kps__TimeoutSeconds=30

# Belediye entegrasyonu kaydında SecretReference=env://MUNICIPALITY_SQL_SECRET kullanılır.
MUNICIPALITY_SQL_SECRET=Server=SQL_PRIVATE_HOST,1433;Database=MUNICIPAL_DB;User Id=municipality_reader;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False

# İlk sistem yöneticisi yalnız SosyoBel.Bootstrap CLI ile oluşturulur.
# Gerçek parola dosyaya yazılmaz; interaktif gizli giriş veya secret store kullanılır.
SOSYOBEL_BOOTSTRAP_EMAIL=system.admin@example.invalid
SOSYOBEL_BOOTSTRAP_FIRST_NAME=Cats
SOSYOBEL_BOOTSTRAP_LAST_NAME=Administrator
# SOSYOBEL_BOOTSTRAP_PASSWORD secret store tarafından çalışma anında enjekte edilir.
